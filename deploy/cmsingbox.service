[Unit]
Description=CMSingBox private management service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cmsingbox
ExecStart=/opt/cmsingbox/cmsingbox -data /var/lib/cmsingbox -port 80
Restart=always
RestartSec=5
LimitNOFILE=1048576
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
