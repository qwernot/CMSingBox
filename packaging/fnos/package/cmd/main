#!/bin/bash

is_running() {
  docker inspect cmsingbox-fnos 2>/dev/null | grep -q '"Status": "running"'
}

case "${1:-}" in
  start|stop)
    exit 0
    ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *)
    echo "不支持的操作: ${1:-}" > "${TRIM_TEMP_LOGFILE:-/tmp/cmsingbox-fnos.log}"
    exit 1
    ;;
esac
