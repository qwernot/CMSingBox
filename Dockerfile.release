FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nftables iproute2 tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY dist/cmsingbox-linux-${TARGETARCH} /usr/local/bin/cmsingbox

RUN chmod 0755 /usr/local/bin/cmsingbox

VOLUME ["/data"]
EXPOSE 9092/tcp 2080/tcp 53/tcp 53/udp
ENTRYPOINT ["cmsingbox", "-data", "/data", "-port", "9092"]
